NODE_ENV=development
PORT=3000

# Database (SQL Server)
DB_HOST=sqlserver
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_DATABASE=gestao_frota_db

# JWT
JWT_SECRET=supersecret_jwt_key_change_me
JWT_EXPIRES_IN=3600s

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TTL=600

# MongoDB (Audit Logs)
MONGODB_URI=mongodb://mongo:27017/gestao_frota_audit

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Other
LOG_LEVEL=info
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Localhost configuration examples
# e não via Docker Compose.
# DB_HOST=localhost
# REDIS_HOST=localhost
# REDIS_PORT=6379
# MONGODB_URI=mongodb://localhost:27017/gestao_frota_audit
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
